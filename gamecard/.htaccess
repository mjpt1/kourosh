Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(README\.txt|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>

# ---------- آدرس‌های تمیز (سئو) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # برای اجبار به https خط‌های زیر را از حالت کامنت خارج کنید
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^product/(\d+)(/.*)?$ product.php?id=$1 [L,QSA]
  RewriteRule ^category/([^/]+)/?$ index.php?cat=$1 [L,QSA]
  RewriteRule ^art/p(\d+)\.svg$ art.php?id=$1 [L]
  RewriteRule ^art/c(\d+)\.svg$ art.php?cat=$1 [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^account/?$ account.php [L,QSA]
  RewriteRule ^login/?$ login.php [L,QSA]
</IfModule>

# ---------- سرعت: فشرده‌سازی ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml application/json
</IfModule>

# ---------- سرعت: کش مرورگر ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
